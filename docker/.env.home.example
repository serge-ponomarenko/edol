# Copy outside the repository as ../../.env_edol_home and replace placeholders.
# This file is for the home Compose project only. Do not use it with a secure
# multi-tenant or Keycloak Compose file.
POSTGRES_DB=edol_home
POSTGRES_USER=replace-with-home-db-user
POSTGRES_PASSWORD=replace-with-home-db-password
# A clean home database uses the dedicated PostgreSQL bootstrap user for both
# Hub runtime and Flyway. It does not create the Stage 3 secure role set.
HUB_RUNTIME_DB_USER=replace-with-home-db-user
HUB_RUNTIME_DB_PASSWORD=replace-with-home-db-password
HUB_FLYWAY_DB_USER=replace-with-home-db-user
HUB_FLYWAY_DB_PASSWORD=replace-with-home-db-password
SERVER_PORT=8080
QR_URL=http://localhost:8090
WEB_ADMIN_NAME=replace-with-home-admin-name
WEB_ADMIN_PASSWORD=replace-with-home-admin-password
EDOL_HOME_POSTGRES_PORT=15432
EDOL_HOME_HUB_PORT=18090
EDOL_HOME_CORE_PORT=18091
