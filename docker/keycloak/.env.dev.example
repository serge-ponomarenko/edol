# Copy outside the repository as ../../.env_edol_keycloak_dev and replace all placeholders.
EDOL_DEPLOYMENT_MODE=secure-multi-tenant
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=edol-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-dev-secret
KEYCLOAK_DATABASE_PASSWORD=replace-with-a-dev-secret
KEYCLOAK_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-different-dev-secret
EDOL_HUB_WEB_CLIENT_SECRET=replace-with-a-dev-secret
# Dev Keycloak serves a Hub instance running locally from IntelliJ IDEA.
EDOL_HUB_WEB_REDIRECT_URI=http://localhost:8090/login/oauth2/code/edol-keycloak
EDOL_HUB_WEB_ORIGIN=http://localhost:8090
KEYCLOAK_DEV_HOSTNAME=auth.dev.edol.s-pon.dev
KEYCLOAK_DEV_HOST_PORT=18443
EDOL_KEYCLOAK_SSL_REQUIRED=all
EDOL_SMTP_HOST=smtp.resend.com
EDOL_SMTP_PORT=587
EDOL_SMTP_AUTH=true
EDOL_SMTP_USER=resend
EDOL_SMTP_PASSWORD=replace-with-a-resend-api-key
EDOL_SMTP_STARTTLS=true
EDOL_SMTP_FROM=no-reply@edol.s-pon.dev
