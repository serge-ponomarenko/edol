{
  "mcpServers": {
    "edol-postgres": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": [
        "-y",
        "@microsoft/postgres-mcp",
        "run",
        "--no-telemetry"
      ]
    },
    "sonarqube": {
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& (Join-Path $env:USERPROFILE '.edol\\sonarqube\\start-sonarqube-mcp.ps1')"
      ]
    }
  }
}
