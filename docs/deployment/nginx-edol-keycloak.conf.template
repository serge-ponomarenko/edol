# Secure-multi-tenant only. Deploy after Stage H acceptance: home mode has no
# Keycloak host, port, secret, or Nginx location. This configuration runs in
# the nginx-home container, whose service must join the external Docker network
# edol-reverse-proxy. Do not reference nginx_default, a host loopback port, or
# a container IP address. The Keycloak aliases below resolve through Docker DNS.
#
# Docker's embedded resolver is reachable at 127.0.0.11 inside each container.
# A variable proxy_pass defers resolution until request time, so Nginx can be
# validated/recreated before a Keycloak container exists. Do not expose the
# Keycloak management port 9000 or PostgreSQL through this configuration.
# <ADMIN_CIDR> is the approved external administrator network; 127.0.0.1 below
# refers only to nginx-home itself, never to the Debian host.

server {
    listen 80;
    server_name auth.dev.edol.s-pon.dev;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name auth.dev.edol.s-pon.dev;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $edol_keycloak_upstream edol-keycloak-dev:8080;

    ssl_certificate /etc/letsencrypt/live/auth.dev.edol.s-pon.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.dev.edol.s-pon.dev/privkey.pem;

    location ^~ /admin/ {
        allow 127.0.0.1;
        allow <ADMIN_CIDR>;
        deny all;
        proxy_pass http://$edol_keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /realms/master/ {
        allow 127.0.0.1;
        allow <ADMIN_CIDR>;
        deny all;
        proxy_pass http://$edol_keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://$edol_keycloak_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
    }
}

