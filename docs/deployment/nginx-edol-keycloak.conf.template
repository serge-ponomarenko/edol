# Secure-multi-tenant only. Deploy after Stage H acceptance: home mode has no
# Keycloak host, port, secret, or Nginx location. Copy to the Debian Nginx
# configuration, replace <ADMIN_CIDR>, test with `nginx -t`, then reload Nginx.
# Do not expose the Keycloak admin surface to the public Internet. Keep the two
# upstream ports loopback-only.

server {
    listen 80;
    server_name auth.dev.edol.s-pon.dev;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name auth.dev.edol.s-pon.dev;

    ssl_certificate /etc/letsencrypt/live/auth.dev.edol.s-pon.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.dev.edol.s-pon.dev/privkey.pem;

    location ^~ /admin/ {
        allow 127.0.0.1;
        allow <ADMIN_CIDR>;
        deny all;
        proxy_pass http://127.0.0.1:18443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /realms/master/ {
        allow 127.0.0.1;
        allow <ADMIN_CIDR>;
        deny all;
        proxy_pass http://127.0.0.1:18443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:18443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
    }
}

